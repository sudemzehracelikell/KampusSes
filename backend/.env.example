# KampüsSes ortam ayarları — örnek dosya (NFR-09, NFR-13).
# Kurulum: bu dosyayı ".env" adıyla kopyalayın (Windows: copy .env.example .env).
# .env dosyası depoya gönderilmez (.gitignore). Bu dosyaya gerçek şifre veya anahtar YAZMAYIN.

# Geliştirme ortamı için True. Yayında mutlaka False olmalı (NFR-13).
DEBUG=True

# Yayında zorunlu. Boş bırakılırsa ve DEBUG=True ise her başlatmada geçici anahtar üretilir.
# Üretmek için: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# İzin verilen sunucu adları ve frontend adresleri (virgülle ayrılır).
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Kayıtta kabul edilen e-posta alan adları. Boş = her alan adı (yalnızca geliştirme).
# Örnek: ALLOWED_EMAIL_DOMAINS=istun.edu.tr
ALLOWED_EMAIL_DOMAINS=istun.edu.tr

# E-postalar geliştirmede konsola yazılır (terminalde görünür).
# Gerçek gönderim için: EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend ve aşağıdaki SMTP ayarları.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=kampusses@localhost
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
# Sunucu yanıt vermezse en fazla kaç saniye beklensin (NFR-14).
EMAIL_TIMEOUT=10

# PostgreSQL kullanılacaksa doldurun; DB_NAME boşsa SQLite kullanılır.
DB_NAME=
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
